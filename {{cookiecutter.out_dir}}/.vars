{% for key, value in cookiecutter.items() -%}
{{ key }}: {{ value }}
{% endfor %}

{% import "_macros.jinja2" as macros %}

{% set min_sdk_version = macros.get_value(cookiecutter.pyproject, "tool.flet.android.min_sdk_version1") %}
min_sdk_version: {{ min_sdk_version if min_sdk_version else "flutter.minSdkVersion" | trim }}